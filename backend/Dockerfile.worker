FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Playwright needed for scraper tasks triggered by Celery.
# Installed as root (build time) but the app runs as appuser (runtime) — point
# both at a shared, world-readable path so appuser can actually find the browser.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python3 -m playwright install chromium --with-deps && \
    chmod -R a+rX /ms-playwright

# Cache-bust arg — pass --build-arg CACHE_BUST=$(date +%s) to force re-copy of migrations
ARG CACHE_BUST=1

COPY app/ ./app/
COPY migrations/ ./migrations/
COPY alembic.ini .

# Strip macOS AppleDouble resource fork files (._*) that corrupt Python imports
RUN find /app -name "._*" -delete && find /app -name ".DS_Store" -delete

# Beat schedule persistence dir — mounted as a named volume in docker-compose.yml.
# Without this, the schedule file lives in the ephemeral container layer, so every
# `docker compose up -d --build` (any deploy) wipes it. Beat then thinks periodic
# tasks have never run and fires them immediately on startup — with refresh_all_prices
# fanning out one task per product every time it runs, repeated restarts compound
# into a runaway queue (confirmed: 6.4K -> 2M+ tasks across a handful of same-day deploys).
RUN mkdir -p /app/beat-data

# Non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Beat + worker combined (same as Render config).
# -Q explicitly lists every queue tasks get routed to (celery_app.py task_routes
# sends price refreshes to "prices" and alerts to "notifications"). Without -Q,
# Celery only consumes the implicit default "celery" queue — every routed task
# would pile up in Redis forever, un-consumed, no matter how long the worker runs.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--beat", "--loglevel=info", "--concurrency=2", "-Q", "celery,prices,notifications", "--schedule=/app/beat-data/celerybeat-schedule"]
