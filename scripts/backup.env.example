# Copy to /opt/pricebasket/.backup_env on the server (chmod 600). Never commit
# the real file — it's account-specific and gets recreated every time you
# switch AWS accounts.

BACKUP_S3_BUCKET=pricebasket-backups

# Only needed if the EC2 instance does NOT have an IAM role with s3:PutObject
# on the bucket above (an instance role is the safer option — no keys to leak).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
